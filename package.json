{
  "name": "data-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22.22.2" },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.15.0",
    "@vercel/node": "29.0.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "jsdom": "31.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
